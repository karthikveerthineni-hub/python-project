select  *from company where country= "India" or "USA";
CREATE TABLE comp (
    id INT PRIMARY KEY,
    country VARCHAR(50),
    score INT,
    branch VARCHAR(50),
    employee VARCHAR(100)
);
INSERT INTO comp (id, country, score, branch, employee)
