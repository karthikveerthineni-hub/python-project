select country,count(*) as no_of from comp group by country;

select country,max(score) as maximum from comp group by country;

select country,min(score) as minimum from comp group by country;

select country,avg(score) as avg_score from comp group by country;

select country,sum(score) as sum_score from comp group by country;

select country,sum(score) as sum_score from comp group by country having sum_score > 80;

select country,sum(score) as sum_score from comp group by country having sum_score > 80 order by sum_score;

select country,sum(score) as sum_score from comp group by country having sum_score > 80 order by sum_score desc;

select *from comp;

select country,avg(score) from comp group by country;

select branch,count(*) as ad,sum(score) as sum_s from comp where score > 70 group by branch having sum_s>80 order by sum_s;


