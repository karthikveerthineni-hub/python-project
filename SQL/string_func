SELECT LOWER(TRIM(emp_name)) AS normalized_name,count(*) as total
FROM Employees group by normalized_name;

SELECT emp_name
FROM Employees
WHERE LOWER(TRIM(emp_name)) LIKE '%n';

select emp_name,length(trim(emp_name)) as len from employees where length(trim(emp_name))=5;

select emp_name,lower(replace(emp_name,'a','@')) as replace_lower from employees;

select emp_name,char_length(emp_name) as len from employees where char_length(emp_name) = 5;

select emp_name,concat(left(emp_name,1),repeat('*',length(emp_name)-2),right(emp_name,1)) from employees where length(emp_name) >2;

SELECT emp_name
FROM Employees
